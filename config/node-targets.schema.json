{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KX-OBH node target configuration",
  "type": "object",
  "required": ["declared", "testedOnHost"],
  "additionalProperties": true,
  "properties": {
    "declared": {
      "type": "array",
      "items": { "type": "integer", "minimum": 18 },
      "minItems": 1
    },
    "testedOnHost": {
      "type": "array",
      "items": { "type": "integer", "minimum": 18 }
    },
    "hostNodeVersion": { "type": "string" },
    "notes": { "type": "string" }
  }
}
